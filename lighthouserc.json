{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve-dist.mjs",
      "startServerReadyPattern": "serving dist/",
      "url": ["http://localhost:4173/", "http://localhost:4173/coach"],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "http://localhost:4173/$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "categories:seo": ["warn", { "minScore": 0.95 }]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:4173/coach$",
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.9 }],
            "categories:performance": ["warn", { "minScore": 0.8 }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci/report"
    }
  }
}
