# Supabase (optional). Without these the app runs entirely as a guest:
# every mode stays playable, only the worldwide leaderboard needs an account.
# Create a project on https://supabase.com, then copy Settings > API.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Public URL of the deployment, used for the social preview tags. Leave it
# unset in development: the preview paths simply stay relative.
VITE_SITE_URL=https://chesstrainer.example

# Error reporting (optional). Without it the app sends nothing at all. Create a
# project on Sentry, choosing the EU region, and paste its DSN here.
VITE_SENTRY_DSN=https://xxxxxxxx@oXXXXXX.ingest.de.sentry.io/XXXXXXX

# Uploading source maps to Sentry, so a stack trace names a file and a line
# instead of a minified chunk. Build-time only, and never sent to the browser —
# unlike the VITE_ variables above, these must not carry that prefix.
#
# Create the token under Sentry > Settings > Auth Tokens with the project:releases
# and org:read scopes. Without it the build simply skips the upload.
#
# These are read through Vite's loadEnv, so setting them here works as written;
# a real environment variable, which is how Netlify supplies the token, wins over
# the file.
# SENTRY_AUTH_TOKEN=sntrys_...
# SENTRY_ORG=amayyas
# SENTRY_PROJECT=chesstrainer
# The EU region. The plugin defaults to the US one, which fails against an EU org.
# SENTRY_URL=https://de.sentry.io
